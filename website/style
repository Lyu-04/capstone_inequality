

    .panel { cursor: default !important; }
    .panel * { cursor: default !important; }

    body { margin: 0; font-family: 'Inter', sans-serif; }

    #map { width: 100%; height: 100vh; }


/* #region Panel Styles */
    .panel {
      position: absolute; top: 16px; left: 16px; z-index: 10;
      width: 500px;
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0px 8px 10px -6px rgba(0,0,0,0.10), 0px 20px 25px -5px rgba(0,0,0,0.10);
      border-radius: 14px;
      outline: 0.80px #E5E7EB solid;
      outline-offset: -0.80px;
      padding: 24px;
      box-sizing: border-box;
    }

    .panel-title {
      color: #101828; font-size: 27px; font-weight: 600;
      line-height: 30px; margin: 0 0 12px 0;
    }

    .panel-subtitle {
      color: #4A5565; font-size: 19px; font-weight: 400;
      line-height: 20px; margin: 0 0 40px 0;
    }

    .indicators-list {
      display: flex; flex-direction: column;
      gap: 10px; margin-bottom: 20px;
      margin-top: 20px;
      padding-bottom: 50px;
    }

    .indicator-item {
      width: 100%; height: 51px; padding: 0 16px;
      background: white; border-radius: 10px;
      outline: 1.6px #E5E7EB solid; outline-offset: -1.6px;
      display: flex; align-items: center; gap: 12px;
      box-sizing: border-box; cursor: pointer;
      border: none; text-align: left;
      transition: all 0.2s ease;
    }

    .indicator-item:hover {
      background: #FFF7ED; outline: 1.6px #FB923C solid;
      box-shadow: 0px 4px 12px rgba(251, 146, 60, 0.25);
      transform: translateX(3px);
    }

    .indicator-item:hover .indicator-label { color: #C2410C; }
    .indicator-item:hover svg rect,
    .indicator-item:hover svg path { stroke: #C2410C; }

    .indicator-item.active {
      background: #FEF3C6; outline: 1.6px #FFD230 solid;
      box-shadow: 0px 2px 4px -2px rgba(0,0,0,0.10), 0px 4px 6px -1px rgba(0,0,0,0.10);
    }

    .indicator-item.active:hover {
      background: #FEF3C6; outline: 1.6px #FB923C solid;
      box-shadow: 0px 4px 12px rgba(251, 146, 60, 0.3);
    }

    .indicator-item.active .indicator-label { color: #BB4D00; }
    .indicator-item.active svg rect,
    .indicator-item.active svg path { stroke: #BB4D00; }

    .indicator-icon {
      width: 20px; height: 20px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }

    .indicator-label {
      font-size: 20px; font-weight: 500;
      line-height: 24px; color: #4A5565;
      transition: color 0.2s ease;
    }

    .selected-badge {
      margin-left: auto; background: #FB923C;
      color: white; font-size: 11px; font-weight: 600;
      padding: 2px 8px; border-radius: 20px;
      opacity: 0; transition: opacity 0.2s ease;
    }

    .indicator-item.active .selected-badge { opacity: 1; background: #BB4D00; }

    .filter-group {
      display: flex; flex-direction: column;
      gap: 8px; margin-bottom: 16px; position: relative;
    }

    .filter-label {
      color: #364153; font-size: 14px;
      font-weight: 600; line-height: 20px;
    }

    .custom-select { position: relative; width: 100%; }

    .select-trigger {
      width: 100%; height: 42px; padding: 0 14px;
      background: white; border-radius: 10px;
      outline: 1.6px #E5E7EB solid; outline-offset: -1.6px;
      border: none; display: flex; align-items: center;
      justify-content: space-between; cursor: pointer;
      box-sizing: border-box; transition: all 0.2s ease;
      font-family: 'Inter', sans-serif;
    }

    .select-trigger:hover { outline: 1.6px #FB923C solid; background: #FFF7ED; }
    .select-trigger.open { outline: 1.6px #FB923C solid; border-radius: 10px 10px 0 0; }

    .select-trigger-text { font-size: 14px; font-weight: 400; color: #9CA3AF; }
    .select-trigger-text.selected { color: #364153; font-weight: 500; }

    .select-arrow { font-size: 10px; color: #9CA3AF; transition: transform 0.2s ease; }
    .select-trigger.open .select-arrow { transform: rotate(180deg); }

    .select-dropdown {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      background: white; border-radius: 0 0 10px 10px;
      outline: 1.6px #FB923C solid; outline-offset: -1.6px;
      overflow: hidden; box-shadow: 0px 8px 16px rgba(0,0,0,0.08); z-index: 100;
    }

    .select-dropdown.open { display: block; }

    .select-option {
      padding: 10px 14px; font-size: 14px; font-weight: 400; color: #364153;
      cursor: pointer; transition: all 0.15s ease;
      font-family: 'Inter', sans-serif; border-bottom: 0.8px solid #F3F4F6;
    }

    .select-option:last-child { border-bottom: none; }
    .select-option:hover { background: #FFF7ED; color: #C2410C; padding-left: 18px; }
    .select-option.chosen { background: #FEF3C6; color: #BB4D00; font-weight: 500; }

    .panel-footer { padding-top: 16px; border-top: 0.8px #E5E7EB solid; }

    .footer-text { color: #6A7282; font-size: 12px; font-weight: 400; line-height: 16px; }
/* #endregion */


/* #region Hover tooltip */
  
    
    .hover-panel {
  position: fixed;
  z-index: 20;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0px 8px 24px rgba(0,0,0,0.15);
  outline: 1px solid #E5E7EB;
  pointer-events: none;
  display: none;
  min-width: 220px;
  font-family: 'Inter', sans-serif;
}

.hover-panel-header {
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #F3F4F6;
}

.hover-panel-name {
  font-size: 14px;
  font-weight: 600;
  color: #101828;
  padding-bottom: 3px;
}

.hover-panel-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.indicator-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.indicator-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.indicator-row-label {
  font-size: 12px;
  font-weight: 500;
  color: #4A5565;
}

.indicator-row-value {
  font-size: 12px;
  font-weight: 600;
  color: #101828;
}

.indicator-bar-bg {
  width: 100%;
  height: 6px;
  background: #F3F4F6;
  border-radius: 99px;
  overflow: hidden;
}

.indicator-bar-fill {
  height: 100%;
  border-radius: 99px;
}

.no-indicators {
  font-size: 12px;
  color: #9CA3AF;
  font-style: italic;
}

/* #endregion */


/* #region Detail panel */
.detail-panel {
  position: fixed;
  top: 0;
  right: 0;
  z-index: 10;
  width: 500px;
  height: 100vh;
  background: rgba(255, 255, 255, 0.97);
  padding: 24px;
  box-shadow: -8px 0px 24px rgba(0,0,0,0.12);
  outline: 1px solid #E5E7EB;
  font-family: 'Inter', sans-serif;
  scrollbar-width: none;
  box-sizing: border-box;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
  overflow-x: hidden;
}

.detail-panel::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}

.detail-panel.open {
  transform: translateX(0);
}

.detail-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 30px;
  border-bottom: 1px solid #F3F4F6;
}

.detail-panel-name {
  font-size: 25px;
  font-weight: 600;
  color: #101828;
  
}

.detail-panel-close {
  background: none;
  border: none;
  color: #9CA3AF;
  font-size: 18px;
  cursor: pointer;
  padding: 4px 8px;
  line-height: 1;
  border-radius: 6px;
  transition: all 0.15s ease;
}

.detail-panel-close:hover {
  color: #101828;
  background: #F3F4F6;
}

#detail-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding-bottom: 24px;
  padding-top: 8px;
}

#detail-body-2 {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: 24px;
}
.detail-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.view-more-btn {
  background: #F3F4F6;
  border: none;
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 500;
  color: #364153;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
}

.view-more-btn:hover {
  background: #E5E7EB;
  color: #101828;
}

.detail-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}
/* Indicator cards */
.indicator-card {
  width: 100%;
  background: linear-gradient(135deg, #FEF2F2 0%, #FFF7ED 100%);
  border-radius: 14px;
  outline: 1.6px #FFC9C9 solid;
  outline-offset: -1.6px;
  padding: 16px;
  box-sizing: border-box;
  position: relative;
}

.indicator-card.health {
  background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
  outline-color: #86EFAC;
}

.indicator-card.income {
  background: linear-gradient(135deg, #FEF3C6 0%, #FEF9C3 100%);
  outline-color: #FDE68A;
}

.indicator-card.housing {
  background: linear-gradient(135deg, #F5F3FF 0%, #EDE9FE 100%);
  outline-color: #C4B5FD;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}



.education .card-icon { background: #FFE2E2; }
.health    .card-icon { background: #DCFCE7; }
.income    .card-icon { background: #FEF9C3; }
.housing   .card-icon { background: #EDE9FE; }

.card-score-block {
  text-align: right;
}

.card-score {
  font-size: 24px;
  font-weight: 700;
  line-height: 32px;
  color: #101828;
}

.card-score-label {
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  color: #6A7282;
}

.card-title {
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
  color: #101828;
  margin-bottom: 4px;
}

.card-neighborhood {
  font-size: 12px;
  font-weight: 500;
  color: #364153;
  margin-bottom: 6px;
}

.card-description {
  font-size: 12px;
  font-weight: 400;
  color: #4A5565;
  margin-bottom: 12px;
}

.card-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}

.card-button {
  width: 100%;
  height: 37.6px;
  background: rgba(255,255,255,0.8);
  border-radius: 10px;
  outline: 0.8px #E5E7EB solid;
  border: none;
  font-size: 14px;
  font-weight: 500;
  color: #364153;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  transition: background 0.15s ease;
}

.card-button:hover {
  background: white;
}
/* #endregion */

/* #region View More*/
.detail-tabs {
  display: flex;
  align-items: flex-end;
  gap: 4px;
  padding-top: 16px;
  border-bottom: 2px solid #E5E7EB;
  flex-shrink: 0;
}

.detail-tab {
  padding: 12px 16px;
  font-size: 16px;
  font-family: 'Segoe UI Emoji', 'Inter', sans-serif;
  font-weight: 500;
  color: #4A5565;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
  border: 1px solid transparent;
  border-bottom: none;
  margin-bottom: -2px;
}

.detail-tab:hover {
  color: #101828;
  background: #F8FAFC;
}

.detail-tab.active {
  color: #101828;
  background: #F8FAFC;
  border-color: #E5E7EB;
  border-top: 2px solid #E5E7EB;
  border-bottom: 2px solid #F8FAFC;
}

.chart-card {
  background: white;
  border-radius: 14px;
  outline: 1px solid #E5E7EB;
  padding: 24px;
  margin-top: 16px;
  box-shadow: 0px 1px 2px -1px rgba(0,0,0,0.10), 0px 1px 3px rgba(0,0,0,0.10);
}

.chart-title {
  font-size: 18px;
  font-family: 'Segoe UI Emoji', sans-serif;
  font-weight: 400;
  color: #101828;
  line-height: 28px;
  margin-bottom: 4px;
}

.chart-subtitle {
  font-size: 14px;
  font-family: 'Segoe UI Emoji', sans-serif;
  font-weight: 400;
  color: #4A5565;
  line-height: 20px;
  margin-bottom: 20px;
}

.chart-area {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.chart-bars {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.chart-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chart-label {
  font-size: 12px;
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  color: #6B7280;
  width: 48px;
  text-align: right;
  flex-shrink: 0;
}

.chart-bar-wrap {
  flex: 1;
  background: #FEE2E2;
  border-radius: 4px;
  height: 18px;
  overflow: hidden;
}

.chart-bar {
  height: 100%;
  background: #EF4444;
  border-radius: 4px;
  transition: width 0.4s ease;
}

.chart-x-axis {
  display: flex;
  justify-content: space-between;
  padding-left: 60px;
  font-size: 12px;
  font-family: 'Inter', sans-serif;
  color: #6B7280;
  margin-top: 4px;
}

/* #endregion */

/* #region Interventions */
.interventions-section {
  grid-column: 1 / -1;
  margin-top: 8px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.suggest-btn {
  width: 100%;
  height: 44px;
  background: #101828;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  transition: background 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.suggest-btn:hover { background: #1f2d40; }

.suggest-btn.loading {
  background: #364153;
  cursor: wait;
}

.interventions-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.intervention-card {
  background: white;
  border-radius: 10px;
  padding: 14px 16px;
  outline: 1px solid #E5E7EB;
  box-shadow: 0px 1px 3px rgba(0,0,0,0.08);
}

.intervention-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.intervention-name {
  font-size: 13px;
  font-weight: 600;
  color: #101828;
}

.intervention-pillar {
  font-size: 11px;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: 20px;
  background: #F3F4F6;
  color: #4A5565;
}

.intervention-desc {
  font-size: 12px;
  font-weight: 400;
  color: #4A5565;
  line-height: 1.5;
}

.intervention-source {
  font-size: 11px;
  color: #9CA3AF;
  margin-top: 6px;
}

/* #endregion */
